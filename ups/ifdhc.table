    EnvSet(IFDHC_FQ_DIR, ${UPS_PROD_DIR}/${UPS_PROD_FLAVOR}-c14-p3915-debug )

  Action = ExtraSetup
    setupRequired( python v3_9_15 )
    setupRequired( clang v14_0_6c )


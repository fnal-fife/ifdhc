  Action=DefineFQ
    EnvSet(IFDHC_FQ_DIR, ${UPS_PROD_DIR}/${UPS_PROD_FLAVOR}-e20-p3915-prof )

  Action = ExtraSetup
    setupRequired( python v3_9_15 )
    setupRequired( gcc v9_3_0 )


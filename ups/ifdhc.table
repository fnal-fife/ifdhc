    EnvSet(IFDHC_FQ_DIR, ${UPS_PROD_DIR}/${UPS_PROD_FLAVOR}-e26-p3913-debug )

  Action = ExtraSetup
    setupRequired( python v3_9_13 )
    setupRequired( gcc v12_1_0 )

